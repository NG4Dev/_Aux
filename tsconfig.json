{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@assets/*": ["assets/*"],
      "@constants/*": ["constants/*"],
      "@videos/*": ["assets/videos/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "constants/**/*.ts",
    "assets/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
