# SQLite database path (relative to project root or absolute)
DISCOVERY_DB_PATH=./data/discovery.db

# Obsidian vault root — exports land in {OBSIDIAN_VAULT_PATH}/business/discovery-catalog/
# Defaults to C:\Users\User\Desktop\Mission Control when unset
OBSIDIAN_VAULT_PATH=C:\Users\User\Desktop\Mission Control

# Google Places API (New) — enable "Places API (New)" on the GCP project
GOOGLE_PLACES_API_KEY=

# Optional: headed browser for CAPTCHA pause flows
SCRAPER_HEADLESS=true
SCRAPER_PAUSE_ON_CAPTCHA=false
