# .easignore replaces .gitignore for EAS upload — keep both in sync.
# See https://docs.expo.dev/build-reference/easignore/

# dependencies
node_modules/

# Native (generated by EAS / expo prebuild)
ios/
android/

.env
.env*.local

# Expo / local artifacts
.expo/
dist/
web-build/
expo-env.d.ts
.expo-tmp-check/
logs/
.local/

# tasks
todo.md

# Native secrets / signing
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro / debug
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*

# OS / certs
.DS_Store
*.pem

# Firebase (injected via EAS file env GOOGLE_SERVICES_*)
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

# Agent docs (not needed on build worker)
docs/*.md
!docs/README.md
