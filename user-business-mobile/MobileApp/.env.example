# Copy to .env for local Metro / dev-client runs.
# EAS preview & TestFlight builds bake these via eas.json — no .env needed on CI.

# Convex deployment (required)
EXPO_PUBLIC_CONVEX_URL=https://tacit-iguana-891.eu-west-1.convex.cloud

# Clerk publishable key (required)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Stripe publishable key (required for payments UI)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Optional: force live Convex data only (no mock feed fallback)
EXPO_PUBLIC_STRICT_LIVE_DATA=true

# Optional: default assistant model for submission builds
# qwen-amd | gemma-fireworks
EXPO_PUBLIC_DEFAULT_ASSISTANT_MODEL=gemma-fireworks

# Optional: set to false to use mock discover data locally
# EXPO_PUBLIC_USE_CONVEX_DATA=true

# Analytics (release when EXPO_PUBLIC_ANALYTICS_ENABLED=true and !__DEV__)
EXPO_PUBLIC_ANALYTICS_ENABLED=false
# Temporary pre-prod / Metro only — unset before true prod cutover
EXPO_PUBLIC_ANALYTICS_ALLOW_DEV=false
EXPO_PUBLIC_MIXPANEL_TOKEN=
EXPO_PUBLIC_INTERNAL_EMAILS=

# GA4 on mobile: Firebase Analytics SDK (google-services.json + GoogleService-Info.plist)
# — NOT Measurement Protocol in the app. See docs/firebase-setup.md
# EAS cloud builds: file env vars GOOGLE_SERVICES_JSON / GOOGLE_SERVICES_PLIST (secret);
# app.config.js copies them into the project root. Do not commit the real files.
