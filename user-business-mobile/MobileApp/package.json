{
  "name": "aux",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "dev:lan": "expo start --dev-client --lan",
    "dev:usb": "expo start --dev-client --lan",
    "dev:telemetry": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-telemetry.ps1",
    "dev:tunnel": "expo start --dev-client --tunnel -c",
    "android": "expo run:android",
    "rebuild:android": "expo prebuild --platform android --clean && expo run:android",
    "rebuild:ios": "expo prebuild --platform ios --clean && expo run:ios",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check-deps": "node ../../scripts/check-outdated-deps.mjs"
  },
